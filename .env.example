# Copy to .env and fill in. Every variable is prefixed with AI_ONCALL_
# except provider credentials (ANTHROPIC_API_KEY, etc.) which follow the
# upstream SDK's convention.

# --- Core ----------------------------------------------------------------
AI_ONCALL_TELEMETRY_STORE=sqlite     # sqlite | duckdb | snowflake | live
AI_ONCALL_LLM_PROVIDER=mock          # mock | anthropic | openai (openai stubbed)
AI_ONCALL_RCA_MODEL=claude-haiku-4-5-20251001
AI_ONCALL_COST_CEILING_USD=0.50      # per-instance hard cap on LLM spend
AI_ONCALL_LATENCY_BUDGET_SECONDS=30  # SLO target the worker stamps on each report
AI_ONCALL_LOG_JSON=false
AI_ONCALL_DATA_DIR=data

# --- LLM provider --------------------------------------------------------
# Required when AI_ONCALL_LLM_PROVIDER=anthropic. Adapter falls back to
# MockLlm and logs a warning when this is unset.
ANTHROPIC_API_KEY=

# --- Telemetry: live driver ---------------------------------------------
# Required when AI_ONCALL_TELEMETRY_STORE=live.
AI_ONCALL_PROMETHEUS_URL=
AI_ONCALL_PROMETHEUS_SERVICE_LABEL=service
AI_ONCALL_PROMETHEUS_TOKEN=
AI_ONCALL_LOKI_URL=
AI_ONCALL_LOKI_SERVICE_LABEL=service
AI_ONCALL_LOKI_TOKEN=

# --- GitHub correlation -------------------------------------------------
# When set, the CORRELATE stage queries the GitHub API for recent PRs on
# each hypothesis's root_cause_service.
AI_ONCALL_GITHUB_TOKEN=
AI_ONCALL_GITHUB_REPO=
AI_ONCALL_GITHUB_API_URL=https://api.github.com

# --- Slack inbound (signatures) -----------------------------------------
# Required for /webhooks/slack/action and /webhooks/slack/event to accept
# any request. Verifier refuses unsigned traffic.
AI_ONCALL_SLACK_SIGNING_SECRET=

# --- Slack outbound (posting RCAs) --------------------------------------
# Required to post to a channel and reply in threads.
AI_ONCALL_SLACK_BOT_TOKEN=
AI_ONCALL_SLACK_DEFAULT_CHANNEL=

# --- CD dispatch (one-click rollback) -----------------------------------
# When set together, the propose-tier Approve button POSTs to this URL
# with an HMAC signature. Refuses to dispatch without the secret.
AI_ONCALL_CD_DISPATCH_URL=
AI_ONCALL_CD_DISPATCH_SECRET=

# --- Auth boundary (P1-9) -----------------------------------------------
# HMAC for inbound /webhooks/alert. When set, every POST must carry
# X-Signature: hmac-sha256=<hex over raw body>.
AI_ONCALL_WEBHOOK_SIGNING_SECRET=

# JSON map of tenant_id -> bearer token. When non-empty, every API
# request must carry Authorization: Bearer <token> matching its tenant.
# Example: {"demo": "tok_demo_abc123", "acme": "tok_acme_xyz789"}
AI_ONCALL_TENANT_TOKENS={}

# --- Privacy (P2-13) -----------------------------------------------------
AI_ONCALL_REDACT_PROMPTS=true        # scrub secrets/PII before sending to LLM
AI_ONCALL_RAW_SECRETS_BLOCKED=false  # if true, refuse outright when a secret is detected

# --- Observability (P2-14) ----------------------------------------------
# Optional Langfuse export — POSTs one generation span per LLM call.
AI_ONCALL_LANGFUSE_PUBLIC_KEY=
AI_ONCALL_LANGFUSE_SECRET_KEY=
AI_ONCALL_LANGFUSE_HOST=https://cloud.langfuse.com
