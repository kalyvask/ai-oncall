{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-oncall.local/schemas/topology_snapshot.json",
  "title": "TopologySnapshot",
  "description": "Service-graph view at a point in time. Built from observed spans with 10-min decay; topology.yaml is fallback.",
  "type": "object",
  "required": ["tenant_id", "captured_at", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "tenant_id": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["service", "status"],
        "additionalProperties": false,
        "properties": {
          "service": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["ok", "warn", "error", "unknown"]},
          "last_events": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["timestamp", "kind", "summary"],
              "properties": {
                "timestamp": {"type": "string", "format": "date-time"},
                "kind": {"type": "string", "enum": ["deploy", "alert", "config_change", "scale", "incident"]},
                "summary": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "calls_per_min": {"type": "number", "minimum": 0},
          "error_rate": {"type": "number", "minimum": 0, "maximum": 1},
          "p99_ms": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
